# Nome do banco (o container do Docker cria automaticamente)
DB_NAME=ludistore

# Usuário e senha do MySQL do container (a senha é definida por você aqui)
DB_USER=root
DB_PASSWORD=troque-pela-sua-senha

# MySQL do Docker publicado na sua própria máquina
DB_HOST=127.0.0.1
# Porta do MySQL do Docker na sua máquina.
# Troque somente se a 3308 já estiver em uso.
DB_PORT=3308