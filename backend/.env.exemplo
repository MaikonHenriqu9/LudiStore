# Copie este arquivo para ".env" (na mesma pasta) e preencha com os SEUS dados.
# O arquivo ".env" NUNCA vai para o repositório. Este ".env.example" vai.

# Chave secreta do Django. Gere uma com:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Cole entre aspas simples.
SECRET_KEY='troque-por-uma-chave-gerada'

# Nome do banco criado no MySQL (todos do grupo usam o mesmo nome)
DB_NAME=ludistore

# Seu usuário do MySQL local
DB_USER=root

# A senha do SEU MySQL local
DB_PASSWORD=troque-pela-sua-senha

# MySQL rodando na própria máquina
DB_HOST=127.0.0.1
DB_PORT=3306